RAG_INDEX_ZIP_SHA256=

# Disabled until explicitly selected, priced and budget-configured.
RAG_EMBEDDING_API_ENABLED=false
RAG_EMBEDDING_CACHE=artifacts/embedding-cache.sqlite3
RAG_EMBEDDING_PRICE_FILE=configs/embedding-price.local.json
RAG_OPENAI_API_KEY=
