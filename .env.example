AWS_DEFAULT_REGION=ap-southeast-2
RAG_GOOGLE_CLIENT_ID=
RAG_INVITED_EMAILS=[]
RAG_INDEX_DIR=artifacts/index
RAG_INDEX_VERSION=
RAG_MODEL_DIR=models
RAG_USAGE_TABLE=
RAG_PRICE_FILE=configs/pricing.local.json
RAG_CORS_ORIGIN=http://localhost:5173
RAG_REPORT_DIR=results
# AWS: pinned S3 object version (index.zip), never a moving latest key
RAG_INDEX_BUCKET=
RAG_INDEX_KEY=
